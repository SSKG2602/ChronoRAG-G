{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/chronorag-g-public/evidence-pack.schema.json",
  "title": "Generic evidence pack",
  "description": "Declared logical requirements and physical public evidence records; runtime code validates cross-references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "records"],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^E[1-9][0-9]*$"}
    },
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_record"}
    }
  },
  "$defs": {
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "text", "supports_requirements", "metadata"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "text": {"type": "string", "minLength": 1, "maxLength": 16384},
        "supports_requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^E[1-9][0-9]*$"}
        },
        "metadata": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"minLength": 1, "maxLength": 128},
          "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
        }
      }
    }
  }
}
