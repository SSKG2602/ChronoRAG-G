{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/chronorag-g-public/gtcc.schema.json",
  "title": "Generic synthetic corpus record",
  "description": "A synthetic interoperability schema, not the private processed-corpus schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "text", "subject", "property", "valid_time", "source_time", "attributes"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "text": {"type": "string", "minLength": 1, "maxLength": 16384},
    "subject": {"type": "string", "minLength": 1, "maxLength": 512},
    "property": {"type": "string", "minLength": 1, "maxLength": 512},
    "valid_time": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_time": {"type": "string", "minLength": 1, "maxLength": 256},
    "attributes": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"minLength": 1, "maxLength": 128},
      "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
    },
    "supports_requirements": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^E[1-9][0-9]*$"}
    }
  }
}
